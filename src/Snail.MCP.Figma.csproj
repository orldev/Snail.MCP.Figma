<Project Sdk="Snail.Sdk.Mcp">

    <!--
        A framework-dependent stdio server (Snail.Sdk.Mcp): the plugin bridge runs on ASP.NET Core, so it is not
        published with Native AOT. A dotnet tool of the McpServer kind, installed into ~/.s3l-mcp with -p:Install=true.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <SnailMcpNative>false</SnailMcpNative>
    </PropertyGroup>

    <PropertyGroup>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Local MCP server that gives AI agents 141 tools for reading and editing Figma. Reads go through the live Figma Desktop plugin — no REST quota spent and unsaved edits visible — or through the REST API behind a LiteDB snapshot cache and a sanitizer that keeps the raw Figma JSON out of the model context; writes go through the plugin: nodes, variables, components, FigJam and Slides. Also design tokens in 11 formats, version diffs and Markdown changelogs, and design system extraction from a codebase.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;claude;figma;figjam;design-tokens;design-system;dotnet-tool</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Figma</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Figma</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="LiteDB" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\plugin\**\*"
                 Link="plugin\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Adapters/Editor/Scripts/*.js" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Figma.Tests" />
    </ItemGroup>

</Project>
