<Project Sdk="Snail.Sdk.Mcp">

    <!--
        A native server (Snail.Sdk.Mcp: SnailMcpNative at its default): published with Native AOT, settings and the bridge's
        endpoints bound by generated code, a native dotnet tool package for each platform with a framework-dependent one for
        the rest. Over stdio by default, or shared by every agent of the machine over Streamable HTTP with
        SNAIL_MCP_FIGMA_TRANSPORT=Http (launchd keeps that one running). Installed into ~/.s3l-mcp with -p:Install=true.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <SnailMcpTransport>Both</SnailMcpTransport>
    </PropertyGroup>

    <!-- The tool reference goes into the MkDocs site (docs/mkdocs.yml reads docs/content): tools/ and schemas/ there. -->
    <PropertyGroup>
        <SnailReferenceFolder>$(MSBuildThisFileDirectory)../docs/content</SnailReferenceFolder>
    </PropertyGroup>

    <PropertyGroup>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Local MCP server that gives AI agents 141 tools for reading and editing Figma. Reads go through the live Figma Desktop plugin — no REST quota spent and unsaved edits visible — or through the REST API behind a SQLite snapshot cache and a sanitizer that keeps the raw Figma JSON out of the model context; writes go through the plugin: nodes, variables, components, FigJam and Slides. Also design tokens in 11 formats, version diffs and Markdown changelogs, and design system extraction from a codebase.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;claude;figma;figjam;design-tokens;design-system;dotnet-tool</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Figma</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Figma</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\plugin\**\*"
                 Link="plugin\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Adapters/Editor/Scripts/*.js" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Figma.Tests" />
    </ItemGroup>

</Project>
