<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The one Figma server of this Mac, shared by every agent: MCP over HTTP on 127.0.0.1:9233, the plugin bridge on the
    first free port of 9223-9232, started at login and again whenever it ends. Publishing natively with
    -r osx-arm64 -p:SnailMcpInstall=true writes this job with the machine's paths to ~/.s3l-mcp/Snail.MCP.Figma/ and
    restarts it when the loaded job is the one written; the program is the native binary, so no dotnet runs it.
    The Figma token and every other setting go into ~/.config/s3l-mcp-figma/config.json, which the server reads itself,
    never into this template or the installed job: a job edited by hand is no longer restarted by an install.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>s3l.mcp.figma</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{CURRENT}}/Snail.MCP.Figma</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{HOME}}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SNAIL_MCP_FIGMA_TRANSPORT</key>
        <string>Http</string>
        <key>SNAIL_MCP_FIGMA_LOG_FILE</key>
        <string>{{HOME}}/Library/Logs/Snail.MCP.Figma.log</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/Snail.MCP.Figma.log</string>
</dict>
</plist>
