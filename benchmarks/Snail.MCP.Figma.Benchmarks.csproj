<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Snail.MCP.Figma.Benchmarks</RootNamespace>
        <!-- A benchmark is named by what it measures; BenchmarkDotNet needs its classes public and unsealed. -->
        <NoWarn>$(NoWarn);CS1591;CA1515;CA1822;CA1001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\Snail.MCP.Figma.csproj" />
    </ItemGroup>

</Project>
